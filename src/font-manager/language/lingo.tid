title: $:/plugins/nikorion/font-manager/language/lingo
tags: $:/tags/Global

\procedure font-manager-lingo(title)
\whitespace trim
<$let _lang={{{ [[$:/language]get[text]get[name]else[en-GB]] }}}>
<$transclude $tiddler={{{ [[$:/plugins/nikorion/font-manager/language/]addsuffix<_lang>addsuffix[/]addsuffix<title>] }}}>
<$transclude $tiddler={{{ [[$:/plugins/nikorion/font-manager/language/en-GB/]addsuffix<title>] }}}/>
</$transclude>
</$let>
\end

\function font-manager-lingo-text(title)
[[$:/language]get[text]get[name]else[en-GB]addprefix[$:/plugins/nikorion/font-manager/language/]addsuffix[/]addsuffix<title>get[text]] :else[[$:/plugins/nikorion/font-manager/language/en-GB/]addsuffix<title>get[text]] :else[<title>]
\end
